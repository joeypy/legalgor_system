# Neon — create DB legalgor_dev for development; legalgor for production
NEON_DB_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST/legalgor_dev?sslmode=require

BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,https://admin.grupolegalgor.com,https://plataforma.grupolegalgor.com

# Comma-separated IPs for admin.grupolegalgor.com (production only)
# Example: ADMIN_IP_ALLOWLIST=153.54.135.239
ADMIN_IP_ALLOWLIST=
