{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "legalgor",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "legalgor"
    }
  ],
  "routes": [
    { "pattern": "grupolegalgor.com", "custom_domain": true },
    { "pattern": "www.grupolegalgor.com", "custom_domain": true },
    { "pattern": "admin.grupolegalgor.com", "custom_domain": true },
    { "pattern": "plataforma.grupolegalgor.com", "custom_domain": true }
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://admin.grupolegalgor.com",
    "BETTER_AUTH_TRUSTED_ORIGINS": "https://admin.grupolegalgor.com,https://plataforma.grupolegalgor.com,https://*.grupolegalgor.com"
  },
  "observability": {
    "enabled": true
  }
}
